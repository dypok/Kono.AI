# ==============================================================================
# 🪙 Kono.ai — Environment Configuration Template
# Copy this file to .env and configure your production / local credentials
# ==============================================================================

# ---- General Environment ----
ENVIRONMENT=development
LOG_LEVEL=info

# ---- Redis Broker & Real-Time Streams ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
KONO_FEED_CHANNEL=kono_feed_channel

# ---- Storage Paths ----
STORAGE_DIR=/data/storage
INBOUND_DIR=/data/storage/inbound
FAILED_DIR=/data/storage/failed

# ---- Database (PostgreSQL / Supabase / SQLite) ----
# Para Supabase Postgres: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite+aiosqlite:////data/storage/kono.db

# ---- ⚡ Supabase & Supabase Auth ----
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ---- 🤖 OpenAI Fallback (Opcional para <5% de casos no deterministas) ----
OPENAI_API_KEY=

# ---- 📧 Inbound Email / Webhook Directo (Sin necesidad de n8n) ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@domain.com
IMAP_PASSWORD=your_app_password
IMAP_POLL_INTERVAL_SEC=60
# Must match the X-Kono-Webhook-Secret header sent by the n8n workflow (US-INT-001)
WEBHOOK_SECRET=kono_secret_n8n_key_2026
MAX_INBOUND_BYTES=15728640

# ---- ⚛️ Frontend Vite Client Configuration ----
VITE_API_URL=http://localhost:80
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
