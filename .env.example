# ==============================================================================
# Kono.ai - Environment Configuration Template
# Copy this file to .env and configure your values
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=info

# Redis Broker & Queues
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage Paths (Local / Docker Volumes)
STORAGE_DIR=/data/storage
INBOUND_DIR=/data/storage/inbound
FAILED_DIR=/data/storage/failed

# Python API & Database
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:////data/storage/kono.db

# OpenAI API Fallback (Optional for <5% edge-cases)
OPENAI_API_KEY=your_openai_api_key_here

# Inbound Email / Webhooks (Optional)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@domain.com
IMAP_PASSWORD=your_app_password
IMAP_POLL_INTERVAL_SEC=60
# Must match the X-Kono-Webhook-Secret header sent by the n8n workflow (US-INT-001)
WEBHOOK_SECRET=kono_secret_n8n_key_2026
MAX_INBOUND_BYTES=15728640

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/ws/audit-feed
