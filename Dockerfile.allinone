# ==============================================================================
# 🪙 Kono.ai — All-in-One Container with Instant Vite HMR & FastAPI Reload
# Combines: Redis + Rust Core + Python FastAPI (--reload) + Vite Dev Server (Live HMR)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Rust Core Binary
# ------------------------------------------------------------------------------
FROM rust:1-slim-bookworm AS rust-builder
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/kono-rust-core
COPY backend/rust-core/Cargo.toml backend/rust-core/Cargo.lock* ./
COPY backend/rust-core/src ./src
RUN cargo build --release

# ------------------------------------------------------------------------------
# Stage 2: Final Runtime Image
# ------------------------------------------------------------------------------
FROM python:3.11-slim-bookworm

# Install Node.js 20, Redis, Nginx, Supervisord, Tesseract OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    redis-server \
    nginx \
    supervisor \
    tesseract-ocr \
    tesseract-ocr-spa \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python API dependencies
COPY backend/python-api/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy Python API source code
COPY backend/python-api/app ./app

# Install Frontend dependencies in /app/frontend
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./

WORKDIR /app

# Copy Rust Binary from Stage 1
COPY --from=rust-builder /usr/src/kono-rust-core/target/release/kono-rust-core /usr/local/bin/kono-rust-core

# Setup shared storage directory & supervisor logs
RUN mkdir -p /data/storage/inbound /data/storage/failed /var/log/supervisor

# Copy Nginx Config
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Configure Supervisord with Live Hot-Reload on FastAPI and Vite Dev Server
RUN cat << 'SUP_EOF' > /etc/supervisor/conf.d/kono.conf
[supervisord]
nodaemon=true
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid

[program:redis]
command=redis-server --daemonize no
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/redis.log
stderr_logfile=/var/log/supervisor/redis_err.log

[program:rust-core]
command=/usr/local/bin/kono-rust-core
autostart=true
autorestart=true
environment=REDIS_URL="redis://127.0.0.1:6379/0",WATCH_DIR="/data/storage/inbound",STORAGE_DIR="/data/storage"
stdout_logfile=/var/log/supervisor/rust.log
stderr_logfile=/var/log/supervisor/rust_err.log

[program:python-api]
command=uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload
directory=/app
autostart=true
autorestart=true
environment=REDIS_URL="redis://127.0.0.1:6379/0",DATABASE_URL="postgresql+asyncpg://kono_app.avkxhplapmibhyleywzd:KonoAiSupabaseSecure2026!@aws-0-us-west-2.pooler.supabase.com:6543/postgres",DATABASE_SYNC_URL="postgresql+psycopg2://kono_app.avkxhplapmibhyleywzd:KonoAiSupabaseSecure2026!@aws-0-us-west-2.pooler.supabase.com:6543/postgres",STORAGE_DIR="/data/storage",PYTHONPATH="/app"
stdout_logfile=/var/log/supervisor/python.log
stderr_logfile=/var/log/supervisor/python_err.log

[program:frontend-dev]
command=npm run dev -- --host 127.0.0.1 --port 5173
directory=/app/frontend
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/frontend.log
stderr_logfile=/var/log/supervisor/frontend_err.log

[program:nginx]
command=nginx -g "daemon off;"
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/nginx.log
stderr_logfile=/var/log/supervisor/nginx_err.log
SUP_EOF

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/kono.conf"]
