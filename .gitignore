# ==========================================
# Kono.ai - Universal .gitignore
# Covers: Python, Rust (Cargo), Node.js (React), Docker & Environments
# ==========================================

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# ------------------------------------------
# Python / FastAPI
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# Rust / Cargo
# ------------------------------------------
/target/
backend/rust-core/target/
**/*.rs.bk
Cargo.lock.bak

# ------------------------------------------
# Node.js / React / Vite
# ------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/
.next/
out/
.vite/

# ------------------------------------------
# Databases & Local Storage
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
uploads/
test_invoices/
inbound_invoices/
storage/

# ------------------------------------------
# AI Assistants, Skills & Local Configs
# ------------------------------------------
.agents/
.gemini/
skills-lock.json
.claude/
.cursor/

# ------------------------------------------
# Sample & Generated Invoices / PDFs
# ------------------------------------------
scripts/facturas_pdf/
*.pdf

# ------------------------------------------
# Operating System & IDEs
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------
# Logs & Process files
# ------------------------------------------
*.log
logs/
*.pid
*.seed
